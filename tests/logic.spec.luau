local H = require("./harness")
local Config = require("../src/shared/Config")
local Growth = require("../src/shared/Logic/Growth")
local Zones = require("../src/shared/Logic/Zones")
local Format = require("../src/shared/Logic/Format")
local describe, it, expect = H.describe, H.it, H.expect
local Z = Config.ZONES

describe("Growth", function()
	it("heightToScale", function()
		expect(Growth.heightToScale(150, 1.5, 12)).toBeCloseTo(1)
		expect(Growth.heightToScale(100, 1.5, 12)).toBeCloseTo(1)
		expect(Growth.heightToScale(1500, 1.5, 12)).toBeCloseTo(2.5)
		expect(Growth.heightToScale(15000, 1.5, 12)).toBeCloseTo(4)
	end)
	it("scaleCapped", function()
		expect(Growth.heightToScale(1e30, 1.5, 12)).toBe(12)
		expect(Growth.heightToScale(math.huge, 1.5, 12)).toBe(12)
	end)
	it("shouldRescale", function()
		expect(Growth.shouldRescale(2.0, 2.01)).toBe(false)
		expect(Growth.shouldRescale(2.0, 2.03)).toBe(true)
	end)
	it("moveStats", function()
		local s = Growth.moveStats(4)
		expect(s.walkSpeed).toBeCloseTo(32)
		expect(s.jumpPower).toBeCloseTo(100)
		expect(s.maxZoom).toBeCloseTo(120)
		expect(s.minZoom).toBeCloseTo(16) -- 거인일 때 카메라가 몸 안으로 들어가지 않게
		expect(Growth.moveStats(1).minZoom).toBeCloseTo(0.5) -- 평소엔 1인칭까지 허용
	end)
end)

describe("Zones", function()
	it("highestUnlocked", function()
		expect(Zones.highestUnlocked(999, Z)).toBe(1)
		expect(Zones.highestUnlocked(1000, Z)).toBe(2)
		expect(Zones.highestUnlocked(100000, Z)).toBe(3)
	end)
	it("canEnter", function()
		expect(Zones.canEnter(999, Z[2])).toBe(false)
		expect(Zones.canEnter(1000, Z[2])).toBe(true)
		expect(Zones.canEnter(0, Z[1])).toBe(true)
	end)
	it("bestGain", function()
		expect(Zones.bestGain(Z[1])).toBe(3)
		expect(Zones.bestGain(Z[3])).toBe(500)
	end)
end)

describe("Format", function()
	it("height", function()
		expect(Format.height(1234)).toBe("1,234cm")
		expect(Format.height(99999)).toBe("99,999cm")
		expect(Format.height(150000)).toBe("1.5km")
		expect(Format.height(250000)).toBe("2.5km")
		expect(Format.height(150.7)).toBe("150cm")
		expect(Format.height(123456789)).toBe("1,234.5km")
	end)
	it("gain", function()
		expect(Format.gain(3)).toBe("+3cm")
		expect(Format.gain(1.5)).toBe("+1.5cm")
	end)
end)

return nil
