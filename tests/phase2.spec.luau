local H = require("./harness")
local Config = require("../src/shared/Config")
local Boost = require("../src/shared/Logic/Boost")
local BossFight = require("../src/shared/Logic/BossFight")
local HighFive = require("../src/shared/Logic/HighFive")
local describe, it, expect = H.describe, H.it, H.expect

describe("Boost", function()
	it("multiplier", function()
		expect(Boost.multiplier(1.25, 0, 100)).toBeCloseTo(1.25)
		expect(Boost.multiplier(1.25, 130, 100)).toBeCloseTo(2.5)
		expect(Boost.multiplier(1, 100, 100)).toBeCloseTo(1) -- 끝난 순간은 아님
	end)
end)

describe("BossFight", function()
	local function newFight()
		return BossFight.new({ maxHp = 100, timeLimit = 90, retryDelay = 30, maxHitsPerSec = 8 })
	end
	it("first hit starts the fight", function()
		local f = newFight()
		expect(f.state(0)).toBe("idle")
		expect(f.hit(1, 10, 0)).toBe(true)
		expect(f.state(0)).toBe("fighting")
		expect(f.hp()).toBe(90)
	end)
	it("hit rate is capped per player", function()
		local f = newFight()
		local accepted = 0
		for i = 1, 20 do
			if f.hit(1, 1, i * 0.01) then
				accepted += 1
			end
		end
		expect(accepted).toBe(8)
		expect(f.hit(2, 1, 0.3)).toBe(true) -- 다른 사람은 따로
	end)
	it("defeat and reward shares", function()
		local f = newFight()
		f.hit(1, 96, 0)
		f.hit(2, 4, 0.1)
		expect(f.state(0.2)).toBe("defeated")
		local winners = f.winners(0.05)
		expect(#winners).toBe(1)
		expect(winners[1]).toBe(1)
	end)
	it("timeout fails, heals, and blocks until retry", function()
		local f = newFight()
		f.hit(1, 50, 0)
		expect(f.state(91)).toBe("failed")
		expect(f.hp()).toBe(100)
		expect(f.hit(1, 10, 100)).toBe(false)
		expect(f.state(122)).toBe("idle")
		expect(f.hit(1, 10, 122)).toBe(true)
	end)
	it("damage grows with body", function()
		expect(BossFight.damageFor(1)).toBeCloseTo(5)
		expect(BossFight.damageFor(4)).toBeCloseTo(80)
	end)
	it("reward cooldown", function()
		expect(BossFight.canReward(nil, 1000, 600)).toBe(true)
		expect(BossFight.canReward(500, 1000, 600)).toBe(false)
		expect(BossFight.canReward(300, 1000, 600)).toBe(true)
	end)
end)

describe("HighFive", function()
	it("request then accept boosts both", function()
		local hf = HighFive.new({ offerTime = 10, cooldown = 60, duration = 30 })
		expect(hf.request(1, 2, 0)).toBe(true)
		local ok, untilT = hf.accept(2, 1, 5)
		expect(ok).toBe(true)
		expect(untilT).toBe(35)
	end)
	it("expired offer and self", function()
		local hf = HighFive.new({ offerTime = 10, cooldown = 60, duration = 30 })
		expect(hf.request(1, 1, 0)).toBe(false)
		hf.request(1, 2, 0)
		expect((hf.accept(2, 1, 11))).toBe(false)
		expect((hf.accept(3, 1, 1))).toBe(false) -- 제안 받은 사람만
	end)
	it("pair cooldown either direction", function()
		local hf = HighFive.new({ offerTime = 10, cooldown = 60, duration = 30 })
		hf.request(1, 2, 0)
		hf.accept(2, 1, 1)
		expect(hf.request(2, 1, 30)).toBe(false)
		expect(hf.request(2, 1, 62)).toBe(true)
	end)
end)

return nil
